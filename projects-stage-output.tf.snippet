# Add this to the PROJECTS stage (next to google_project.host), then apply it
# so the network stage can read host project IDs from that stage's state.

output "host_projects" {
  description = "Net-host project per environment, keyed like var.environments."
  value = {
    for k, p in google_project.host : k => {
      project_id = p.project_id
      env        = var.environments[k]
    }
  }
}
