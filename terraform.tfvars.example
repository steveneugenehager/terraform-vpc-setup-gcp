state_bucket          = "REPLACE-with-your-tfstate-bucket"
projects_state_prefix = "REPLACE-with-projects-stage-prefix"

# Keys must match var.environments keys in the projects stage.
# One /16 per environment, carved into /20 subnets per region; no overlap anywhere.
networks = {
  dev = {
    subnets = {
      use1 = { region = "us-east1",    ip_cidr_range = "10.10.0.0/20" }
      usc1 = { region = "us-central1", ip_cidr_range = "10.10.16.0/20" }
    }
  }
  test = {
    subnets = {
      use1 = { region = "us-east1",    ip_cidr_range = "10.20.0.0/20" }
      usc1 = { region = "us-central1", ip_cidr_range = "10.20.16.0/20" }
    }
  }
  stage = {
    subnets = {
      use1 = { region = "us-east1",    ip_cidr_range = "10.30.0.0/20" }
      usc1 = { region = "us-central1", ip_cidr_range = "10.30.16.0/20" }
    }
  }
  prod = {
    subnets = {
      use1 = {
        region        = "us-east1"
        ip_cidr_range = "10.40.0.0/20"
        flow_logs     = true
        secondary_ranges = {
          gke-pods     = "10.140.0.0/16"
          gke-services = "10.141.0.0/20"
        }
      }
      usc1 = { region = "us-central1", ip_cidr_range = "10.40.16.0/20", flow_logs = true }
    }
  }
}
