# Local .terraform directories (providers, modules, backend config)
.terraform/

# State files: state lives in GCS, never in git
*.tfstate
*.tfstate.*
*.tfstate.backup

# Saved plan files (can contain sensitive values)
*.tfplan
tfplan
*.plan

# Crash logs
crash.log
crash.*.log

# Per-environment terraform.tfvars are committed (config only, no secrets).
# Keep anything sensitive in a local, ignored file instead.
*.secret.tfvars
*.local.tfvars

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# GCP credentials / service account keys
*.json

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
